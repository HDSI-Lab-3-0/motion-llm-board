# Copy to .env in this repository; existing shell variables take precedence.
OUIJA_LOCAL_MODEL=llama3.2:3b
OUIJA_OLLAMA_URL=http://127.0.0.1:11434/api/generate
OUIJA_OLLAMA_TIMEOUT=180
OUIJA_OLLAMA_CONTEXT=2048
# Disable motion during initial tests. Set true for the physical board.
OUIJA_HARDWARE_ENABLED=false
OUIJA_SERIAL_PORT=/dev/ttyACM0
OUIJA_USB_MIC_ALSA=plughw:3,0
OUIJA_WHISPERCPP_DIR=~/whisper.cpp
OUIJA_WHISPER_MODEL=~/whisper.cpp/models/ggml-tiny.en.bin
